REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE_NAME=pr-agent-jobs
WORKDIR_BASE=/tmp/pr-agent

GITHUB_PAT=

CLI_RUNNER_CMD=python
CLI_RUNNER_ARGS=-m pr_agent.claude_shim
CLI_TIMEOUT_SECONDS=900

CLAUDE_CODE_CMD=claude
CLAUDE_CODE_ARGS=

GIT_AUTHOR_NAME=pr-agent
GIT_AUTHOR_EMAIL=pr-agent@example.com

DEFAULT_SEARCH_QUERY=is:issue is:open label:"good first issue"
TEST_COMMAND=
